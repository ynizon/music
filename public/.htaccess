# --- Blocage des robots IA / scrapers (ajout 2026-11-07, sauvegarde : .htaccess.bak) ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/robots\.txt$
    RewriteCond %{HTTP_USER_AGENT} (PerplexityBot|Perplexity-User|meta-externalagent|meta-externalfetcher|FacebookBot|ExaSearchBot|Amazonbot|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|GPTBot|ChatGPT-User|OAI-SearchBot|CCBot|Bytespider|cohere-ai|Diffbot|ImagesiftBot|Omgilibot|Timpibot|YouBot|PetalBot|AhrefsBot|SemrushBot|MJ12bot|DotBot) [NC]
    RewriteRule ^ - [F,L]
</IfModule>
# --- fin blocage ---

#Requiert les modules rewrite, headers, expires, mime, deflate et mod_setenvif pour profiter des meilleurs performances

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On


    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Handle Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

</IfModule>

# Cache navigateur des fichiers statiques (les réponses PHP gardent leurs propres en-têtes)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|gif|svg|ico|webp|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

