# --- Blocage de tous les robots (403 avant Laravel) ---
# Le site est réservé aux IP autorisées (RESTRICT_IP) : un robot ne verrait que /busy.
# Motifs génériques (Applebot/, bingbot/, ElevenlabsCrawler, meta-webindexer, facebookexternalhit...)
# + robots IA dont le nom ne suit pas ces motifs. Seul robots.txt reste accessible.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/robots\.txt$
    RewriteCond %{HTTP_USER_AGENT} ([a-z]bot/|crawler|spider|indexer|externalhit|externalagent|externalfetcher|Perplexity-User|Claude-User|ChatGPT-User|anthropic-ai|cohere-ai|Diffbot|Bytespider|python-requests|Scrapy|HeadlessChrome) [NC]
    RewriteRule ^ - [F,L]
</IfModule>
# --- fin blocage ---

#Requiert les modules rewrite, headers, expires, mime, deflate et mod_setenvif pour profiter des meilleurs performances

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On


    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Handle Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

</IfModule>

# Cache navigateur des fichiers statiques (les réponses PHP gardent leurs propres en-têtes)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|gif|svg|ico|webp|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

